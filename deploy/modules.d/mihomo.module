id=mihomo
name=Mihomo
kind=proxy core
role=VLESS, AnyTLS, Trojan, Snell, Mieru, TrustTunnel, ShadowQUIC and Sudoku runtime
repo=MetaCubeX/mihomo
upstream=pinned-release
ref=v1.19.30
driver=release
root=cores
binary=mihomo
service=infiproxy-mihomo.service
config=/etc/infiproxy-cores/mihomo/config.yaml
asset_amd64=mihomo-linux-amd64-v{version}.gz
asset_arm64=mihomo-linux-arm64-v{version}.gz
