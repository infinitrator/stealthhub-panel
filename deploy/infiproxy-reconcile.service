[Unit]
Description=Infiproxy privileged desired-state reconciler
Documentation=https://github.com/infinitrator/stealthhub-panel
After=network-online.target infiproxy.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/infiproxy/infiproxy.env
ExecStart=/usr/local/libexec/infiproxy-reconcile
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/infiproxy-cores /etc/infiproxy/secrets.d /etc/nginx/sites-available /etc/nginx/sites-enabled /var/lib/infiproxy /var/lib/infiproxy-maintenance
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
